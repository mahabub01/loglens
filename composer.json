{
    "name": "mehrabhossain/loglens",
    "description": "Developer-focused application log analyzer and monitoring dashboard for Laravel 10, 11, 12, and 13",
    "keywords": ["laravel", "logs", "monitoring", "loglens", "mod_status", "performance"],
    "license": "MIT",
    "authors": [
        {
            "name": "Mehrab Hossain",
            "email": "mehrab@example.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1 || ^8.2 || ^8.3 || ^8.4",
        "illuminate/contracts": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/view": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/routing": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/auth": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/session": "^10.0 || ^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "MehrabHossain\\LogLens\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MehrabHossain\\LogLens\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MehrabHossain\\LogLens\\LogLensServiceProvider"
            ],
            "aliases": {
                "LogLens": "MehrabHossain\\LogLens\\Facades\\LogLens"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
